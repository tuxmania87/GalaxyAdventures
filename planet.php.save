if($a==27 && $b==0 && $e==2 && $energiealt>=4 && $addarray[0]+$planet->rohstoffa>=5 && $addarray[3]+$planet->rohstoffd>=3 && $addarray[5]+$planet->tritanium>=3 && $addarray[7]+$planet->antimaterie>=2 && $addarray[8]+$planet->deuterium>=2&& $addarray[1]+$planet->rohstoffb>=3) { $quantprod++; $addarray[0]-=5; $addarray[3]-=3; $addarray[5]-=3; $addarray[7]-=2; $addarray[8]-=2; $addarray[1]-=3; $energie-=4;  $energiealt-=4; }
}


